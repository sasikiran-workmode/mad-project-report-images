---
flowchart LR
    DS["Benchmark Dataset<br/>NQ / HotpotQA /<br/>FEVER / MultiHop"] --> EM
    subgraph EM["Evaluation Methods"]
        direction TB
        B1["Baselines<br/>No-debate,<br/>No-citation"]
        B2["Evidence-MAD<br/>Multi-agent debate<br/>with verification"]
    end
    EM --> MT
    subgraph MT["Evaluation Metrics"]
        direction TB
        M1["Answer Quality<br/>accuracy, F1 score"]
        M2["Citation Quality<br/>precision, recall"]
    end
    MT --> RA
    subgraph RA["Results and Analysis"]
        direction TB
        R1["Performance Comparison<br/>Evidence-MAD vs baselines"]
        R2["Ablation Study<br/>contribution of components"]
    end
    RA --> FR["Final Evaluation Report<br/>quantitative results<br/>and key findings"]
    FR --> DS
