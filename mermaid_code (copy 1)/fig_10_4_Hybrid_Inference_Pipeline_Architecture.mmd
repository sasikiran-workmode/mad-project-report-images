---
config:
  layout: elk
  elk:
    cycleBreakingStrategy: MODEL_ORDER
    considerModelOrder: NODES_AND_EDGES
    nodePlacementStrategy: BRANDES_KOEPF
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffffff"
    primaryBorderColor: "#000000"
    primaryTextColor: "#000000"
    lineColor: "#000000"
    secondaryColor: "#ffffff"
    tertiaryColor: "#ffffff"
    clusterBkg: "#ffffff"
    clusterBorder: "#000000"
    edgeLabelBackground: "#ffffff"
    fontFamily: Arial
  flowchart:
    curve: linear
    htmlLabels: true
---
flowchart LR
    UQ["User Query<br/>(natural language question)"] --> PB
    subgraph DSR["Data Sources"]
        direction TB
        WS["Web Search<br/>real-time information"]
        LK["Local Knowledge<br/>documents / cached data"]
    end
    DSR --> PB
    subgraph HP["Hybrid Inference Pipeline"]
        direction LR
        PB["Prompt Builder<br/>formats query and system instructions"] --> PI["Primary Inference<br/>Gemini API<br/>(query with prompt)"]
        PI --> AP{"API<br/>Success?"}
        AP -- No --> LF["Local Fallback<br/>OpenCode model<br/>(run same prompt locally)"]
    end
    PI --> PP["Response Post-processing<br/>parse, validate and structure output"]
    AP -- Yes --> PP
    LF --> PP
    PP --> FR["Final Response<br/>answer with citations / metadata"]
